	}

	.class-card-text p:last-of-type {
		margin-bottom: 14px;
	}

	.class-more {
		align-self: flex-start;
		margin: 0;
		padding: 0;
		border: none;
		background: none;
		color: inherit;
		font: inherit;
		font-size: 15px;
		text-decoration: underline;
		text-underline-offset: 0.18em;
		cursor: pointer;
